{
  "name": "ghrupuzzle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "guides:build": "node scripts/build-guides.mjs",
    "dev": "npm run guides:build && next dev --turbopack",
    "build": "npm run guides:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests-ts/*.test.ts",
    "accept:contract": "tsx scripts/accept_contract_2_1.ts",
    "typecheck": "tsc --noEmit",
    "cf:build": "npm run guides:build && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply ghrupuzzle --local",
    "db:migrate:remote": "wrangler d1 migrations apply ghrupuzzle --remote"
  },
  "dependencies": {
    "@genomicx/ui": "^0.9.1",
    "better-auth": "^1.6.24",
    "next": "^15.5.21",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.113.0"
  }
}
