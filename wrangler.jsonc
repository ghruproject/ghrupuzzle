{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghrupuzzle",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghrupuzzle",
      "database_id": "SET_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRACTICE_ASSETS",
      "bucket_name": "ghrupuzzle-practice"
    },
    {
      "binding": "PRIVATE_ASSETS",
      "bucket_name": "ghrupuzzle-private"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ghrupuzzle-opennext-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ghrupuzzle"
    }
  ]
}
